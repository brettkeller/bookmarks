{
  "manifest_version": 3,
  "name": "Chrome Tab & Bookmark Organizer",
  "version": "1.0.0",
  "description": "Scan tabs and bookmarks, export to spreadsheets, deduplicate, and reorganize with preview.",
  "permissions": [
    "tabs",
    "tabGroups",
    "bookmarks",
    "history",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
